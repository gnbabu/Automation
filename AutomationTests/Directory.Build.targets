<Project>

  <!--
    Release package: after every build of a TC.* test project, zip exactly the files a Release
    folder needs (test DLL, Selenium.BaseComponents.dll, TestDataModels.dll, appSettings.json,
    TestFiles\) into AutomationTests\ReleasePackages\<AssemblyName>.zip, ready to extract into
    D:\Releases\<Env>\REL-<id>_<name>_v<version>\. Local-run settings, secrets, PDBs and
    framework DLLs are never included.

    Opt out per project with <CreateReleasePackage>false</CreateReleasePackage>, opt in a project
    without the TC. prefix with <CreateReleasePackage>true</CreateReleasePackage>, or skip it for
    one build with -p:CreateReleasePackage=false.
  -->
  <PropertyGroup>
    <CreateReleasePackage Condition="'$(CreateReleasePackage)' == '' And $(MSBuildProjectName.StartsWith('TC.')) And '$(MSBuildProjectName)' != 'TC.OhidEligibilityDemo'">true</CreateReleasePackage>
    <ReleasePackagesDir>$(MSBuildThisFileDirectory)ReleasePackages\</ReleasePackagesDir>
  </PropertyGroup>

  <!-- Visual Studio's fast up-to-date check skips MSBuild entirely when no source changed, so a
       deleted zip would never come back. Declaring the zip as a build output makes VS treat the
       project as out of date (and build it) whenever the zip is missing. -->
  <ItemGroup Condition="'$(CreateReleasePackage)' == 'true'">
    <UpToDateCheckBuilt Include="$(ReleasePackagesDir)$(AssemblyName).zip" />
    <UpToDateCheckBuilt Include="$(MSBuildProjectDirectory)\suite-manifest.json" />
    <!-- Builds the manifest tool first; its DLL is not referenced or copied into the test output. -->
    <ProjectReference Include="$(MSBuildThisFileDirectory)SuiteManifestGenerator\SuiteManifestGenerator.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <!--
    Suite manifest: suite-manifest.json in the test project folder, listing every test case with
    its NUnit attributes (TestCaseId, Description, CancelAfter, Category). Suite-level values come
    from the project's .csproj: TestSuiteName, Version, Description, Authors.
  -->
  <PropertyGroup Condition="'$(CreateReleasePackage)' == 'true'">
    <TestSuiteName Condition="'$(TestSuiteName)' == ''">$(MSBuildProjectName)</TestSuiteName>
    <SuiteManifestPath>$(MSBuildProjectDirectory)\suite-manifest.json</SuiteManifestPath>
    <SuiteManifestTool>$(MSBuildThisFileDirectory)SuiteManifestGenerator\bin\$(Configuration)\net8.0\SuiteManifestGenerator.dll</SuiteManifestTool>
  </PropertyGroup>

  <Target Name="GenerateSuiteManifest"
          AfterTargets="Build"
          Condition="'$(CreateReleasePackage)' == 'true' And '$(DesignTimeBuild)' != 'true' And '$(BuildingForLiveUnitTesting)' != 'true'">
    <PropertyGroup>
      <_SuiteManifestSettings>$(ProjectDir)$(IntermediateOutputPath)suite-manifest.settings</_SuiteManifestSettings>
    </PropertyGroup>
    <ItemGroup>
      <_SuiteManifestLine Include="Assembly=$(TargetPath)" />
      <_SuiteManifestLine Include="Output=$(SuiteManifestPath)" />
      <_SuiteManifestLine Include="TestSuiteName=$(TestSuiteName)" />
      <_SuiteManifestLine Include="Version=$(Version)" />
      <_SuiteManifestLine Include="Description=$(Description)" />
      <_SuiteManifestLine Include="Author=$(Authors)" />
    </ItemGroup>
    <WriteLinesToFile File="$(_SuiteManifestSettings)" Lines="@(_SuiteManifestLine)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <Exec Command="dotnet &quot;$(SuiteManifestTool)&quot; &quot;$(_SuiteManifestSettings)&quot;" />
  </Target>

  <Target Name="CreateReleasePackage"
          AfterTargets="Build"
          DependsOnTargets="GenerateSuiteManifest"
          Condition="'$(CreateReleasePackage)' == 'true' And '$(DesignTimeBuild)' != 'true' And '$(BuildingForLiveUnitTesting)' != 'true'">

    <PropertyGroup>
      <_ReleaseStagingDir>$(ProjectDir)$(IntermediateOutputPath)ReleasePackage\</_ReleaseStagingDir>
      <_ReleaseZip>$(ReleasePackagesDir)$(AssemblyName).zip</_ReleaseZip>
    </PropertyGroup>

    <ItemGroup>
      <_ReleaseFile Include="$(TargetPath)" />
      <_ReleaseFile Include="$(TargetDir)Selenium.BaseComponents.dll" Condition="Exists('$(TargetDir)Selenium.BaseComponents.dll')" />
      <_ReleaseFile Include="$(TargetDir)TestDataModels.dll" Condition="Exists('$(TargetDir)TestDataModels.dll')" />
      <_ReleaseFile Include="$(TargetDir)appSettings.json" Condition="Exists('$(TargetDir)appSettings.json')" />
      <_ReleaseFile Include="$(SuiteManifestPath)" Condition="Exists('$(SuiteManifestPath)')" />
      <_ReleaseTestFile Include="$(TargetDir)TestFiles\**\*" />
    </ItemGroup>

    <RemoveDir Directories="$(_ReleaseStagingDir)" />
    <Copy SourceFiles="@(_ReleaseFile)" DestinationFolder="$(_ReleaseStagingDir)" />
    <Copy SourceFiles="@(_ReleaseTestFile)"
          DestinationFiles="@(_ReleaseTestFile->'$(_ReleaseStagingDir)TestFiles\%(RecursiveDir)%(Filename)%(Extension)')" />
    <MakeDir Directories="$(ReleasePackagesDir)" />
    <ZipDirectory SourceDirectory="$(_ReleaseStagingDir)" DestinationFile="$(_ReleaseZip)" Overwrite="true" />

    <Message Importance="high" Text="Release package: $(_ReleaseZip)" />
  </Target>

</Project>
