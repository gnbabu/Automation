<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- Deliberately pinned older than the shared central versions (see
         Directory.Packages.props) - this is a standalone PoC/sample suite, not part of
         the real Selenium framework, and was never meant to move in lockstep with it. -->
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" VersionOverride="3.14.0" />
    <PackageReference Include="NUnit.Analyzers" VersionOverride="3.9.0" />
    <PackageReference Include="NUnit3TestAdapter" VersionOverride="4.5.0" />
    <PackageReference Include="Selenium.WebDriver" VersionOverride="4.27.0" />
    <PackageReference Include="WebDriverManager" VersionOverride="2.17.5" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

</Project>
